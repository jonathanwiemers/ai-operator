# Base agent image: ai-runner + git + agent CLIs. Extend it with the toolchain
# your projects need to build and test, e.g.
#   FROM ghcr.io/jonathanwiemers/ai-operator-agent:latest
#   USER root
#   RUN apt-get update && apt-get install -y golang-go && rm -rf /var/lib/apt/lists/*
#   USER 1000
FROM --platform=$BUILDPLATFORM golang:1.26 AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY api/ api/
COPY cmd/ cmd/
COPY internal/ internal/
# Declared late so the layers above are shared by all target platforms.
ARG TARGETOS TARGETARCH
RUN CGO_ENABLED=0 GOOS=$TARGETOS GOARCH=$TARGETARCH go build -trimpath -ldflags="-s -w" -o /out/ai-runner ./cmd/runner

FROM node:22-bookworm-slim
ARG INSTALL_CLAUDE=true
ARG INSTALL_CURSOR=true
RUN apt-get update \
 && apt-get install -y --no-install-recommends git ca-certificates curl ripgrep make \
 && rm -rf /var/lib/apt/lists/*
# Claude Code CLI.
RUN if [ "$INSTALL_CLAUDE" = "true" ]; then npm install -g @anthropic-ai/claude-code && npm cache clean --force; fi
# Cursor CLI. Installed outside $HOME because HOME points at the workspace PVC at runtime.
ENV CURSOR_HOME=/opt/cursor
RUN if [ "$INSTALL_CURSOR" = "true" ]; then \
      mkdir -p $CURSOR_HOME && HOME=$CURSOR_HOME bash -c 'curl -fsSL https://cursor.com/install | bash' \
      && chmod -R a+rX $CURSOR_HOME; \
    fi
ENV PATH="/opt/cursor/.local/bin:${PATH}"
# Toolchain installers, pinned and checksum-verified: mise (.mise.toml,
# .tool-versions) and rustup (rust-toolchain.toml; mise's rust backend would
# fetch the rustup script). What they install lives on the workspace PVC
# (HOME is /workspace/home in the agent container), see docs/usage.md.
ARG MISE_VERSION=2026.10.8 RUSTUP_VERSION=1.29.2
RUN set -eu; case "$(dpkg --print-architecture)" in \
      amd64) m=x64 r=x86_64 ms=c72477ae6c3a8e7d817a322f43da70e4643e75ee5c21265f1c19c894273b7428 rs=5be191e8c70a5007074254cb74d78dbfdd25cd5a61c27de7b8e5410122ec24f4;; \
      arm64) m=arm64 r=aarch64 ms=6ee0bd8173f1347514f4974d55fb1fae13aa7f6de0a55338adbefa0667cad7e5 rs=a9c168dbea81a84671c6b7a5c1795cb0eb699020110d107ddfca427bd797e697;; \
      *) exit 1;; \
    esac; \
    curl -fsSLo /usr/local/bin/mise "https://github.com/jdx/mise/releases/download/v$MISE_VERSION/mise-v$MISE_VERSION-linux-$m"; \
    curl -fsSLo /tmp/rustup-init "https://static.rust-lang.org/rustup/archive/$RUSTUP_VERSION/$r-unknown-linux-gnu/rustup-init"; \
    printf '%s  %s\n' "$ms" /usr/local/bin/mise "$rs" /tmp/rustup-init | sha256sum -c -; \
    chmod 755 /usr/local/bin/mise /tmp/rustup-init; \
    CARGO_HOME=/opt/rustup RUSTUP_HOME=/tmp/rustup /tmp/rustup-init -y -q --no-modify-path --profile minimal --default-toolchain none; \
    rm -rf /tmp/rustup-init /tmp/rustup; chmod -R a+rX /opt/rustup
ENV PATH="/opt/rustup/bin:/workspace/home/.toolchains/mise/shims:${PATH}" \
    MISE_DATA_DIR=/workspace/home/.toolchains/mise \
    RUSTUP_HOME=/workspace/home/.toolchains/rustup \
    CARGO_HOME=/workspace/home/.toolchains/cargo
COPY --from=build /out/ai-runner /usr/local/bin/ai-runner
# uid 1000 is the "node" user; the operator runs pods with runAsUser 1000.
USER 1000
WORKDIR /workspace
ENTRYPOINT ["ai-runner"]
