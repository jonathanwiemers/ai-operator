{
  "name": "ai-operator-ui",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build && vite build -c vite.sw.config.ts",
    "typecheck": "vue-tsc --noEmit && tsc -p tsconfig.sw.json",
    "test": "node --test",
    "budget": "node scripts/bundle-budget.mjs",
    "e2e": "tsc -p e2e/tsconfig.json && playwright test",
    "e2e:journey": "tsc -p e2e/tsconfig.json && playwright test --grep @journey",
    "knip": "knip"
  },
  "dependencies": {
    "@iconify-json/lucide": "1.2.153",
    "@nuxt/ui": "4.12.0",
    "chart.js": "4.6.1",
    "tailwindcss": "4.3.5",
    "vue": "3.5.44",
    "vue-chartjs": "5.3.4",
    "vue-draggable-plus": "0.6.1",
    "vue-router": "5.4.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.65.0",
    "@types/node": "22.20.5",
    "@vitejs/plugin-vue": "6.0.10",
    "knip": "6.47.0",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vue-tsc": "3.3.13"
  }
}
